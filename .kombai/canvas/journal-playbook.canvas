      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Instrument+Serif&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.fs{font-family:'IBM Plex Sans',ui-sans-serif,system-ui,sans-serif}\n.fd{font-family:'Instrument Serif',Georgia,serif}\n.fm{font-family:'IBM Plex Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums}\nbody{background:#000}\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js\"></script>\n<div class=\"fs relative flex h-[1000px] overflow-hidden bg-black text-[#f5f5f4] antialiased\" data-kid=\"1\" data-name=\"terminal app layout container\">\n<aside class=\"flex w-[246px] shrink-0 flex-col border-r border-white/[0.07] bg-[#050505]\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n<div class=\"flex items-center gap-3 px-4 pt-5 pb-6\" data-kid=\"1-1-1\" data-name=\"brand header row\">\n<span class=\"flex size-9 items-center justify-center rounded-md bg-[#e50914] text-[18px] text-white\" data-kid=\"1-1-1-1\" data-name=\"red brand icon badge\"><i class=\"icon-shield\" data-kid=\"1-1-1-1-1\" data-name=\"shield icon\"></i></span>\n<div data-kid=\"1-1-1-2\" data-name=\"brand text block\"><p class=\"fd text-[20px] leading-none\" data-kid=\"1-1-1-2-1\" data-name=\"brand name title text\">First Payout</p><p class=\"mt-1 text-[9px] font-semibold tracking-[0.22em] text-[#e50914] uppercase\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle descriptor\">ICT desk terminal</p></div>\n</div>\n<nav class=\"flex flex-col gap-0.5 px-2.5 text-[13px] font-medium\" data-kid=\"1-1-2\" data-name=\"primary navigation menu\">\n<a class=\"flex h-10 items-center gap-3 rounded-md px-3 text-[#a2a2a0]\" data-kid=\"1-1-2-1\" data-name=\"nav link: Today\"><span class=\"text-[15px]\" data-kid=\"1-1-2-1-1\" data-name=\"nav icon wrapper\"><i class=\"icon-layout-dashboard\" dat