me=\"table header row\">\n<tr class=\"h-9 border-b border-white/[0.06] text-left text-[10px] font-semibold tracking-[0.12em] text-[#a2a2a0] uppercase\" data-kid=\"1-2-2-3-2-5-1-1-1\" data-name=\"table header cells row\">\n<th class=\"pl-6 pr-3 font-semibold\" data-kid=\"1-2-2-3-2-5-1-1-1-1\" data-name=\"time column header\">Time</th><th class=\"px-3 font-semibold\" data-kid=\"1-2-2-3-2-5-1-1-1-2\" data-name=\"side column header\">Side</th><th class=\"px-3 font-semibold\" data-kid=\"1-2-2-3-2-5-1-1-1-3\" data-name=\"status column header\">Status</th><th class=\"px-3 text-right font-semibold\" data-kid=\"1-2-2-3-2-5-1-1-1-4\" data-name=\"lots column header\">Lots</th><th class=\"px-3 text-right font-semibold\" data-kid=\"1-2-2-3-2-5-1-1-1-5\" data-name=\"entry column header\">Entry</th><th class=\"px-3 text-right font-semibold\" data-kid=\"1-2-2-3-2-5-1-1-1-6\" data-name=\"exit column header\">Exit</th><th class=\"px-3 text-right font-semibold\" data-kid=\"1-2-2-3-2-5-1-1-1-7\" data-name=\"net P&amp;L column header\">Net P&amp;L</th><th class=\"px-3 text-right font-semibold\" data-kid=\"1-2-2-3-2-5-1-1-1-8\" data-name=\"R column header\">R</th><th class=\"px-3 font-semibold\" data-kid=\"1-2-2-3-2-5-1-1-1-9\" data-name=\"playbook column header\">Playbook</th><th class=\"px-3 font-semibold\" data-kid=\"1-2-2-3-2-5-1-1-1-10\" data-name=\"rules column header\">Rules</th><th class=\"pr-6 pl-3 text-center font-semibold\" data-kid=\"1-2-2-3-2-5-1-1-1-11\" data-name=\"review column header\">Reviewed</th>\n</tr>\n</thead>\n<tbody data-kid=\"1-2-2-3-2-5-1-2\" data-name=\"table body rows\">\n<tr class=\"h-10 border-b border-white/[0.05]\" data-kid=\"1-2-2-3-2-5-1-2-1\" data-name=\"trade log row (win)\">\n<td class=\"fm pl-6 pr-3 text-[12px]\" data-kid=\"1-2-2-3-2-5-1-2-1-1\" data-name=\"trade time cell\">09:41</td><td class=\"px-3\" data-kid=\"1-2-2-3-2-5-1-2-1-2\" data-name=\"trade side cell\">Long</td><td class=\"px-3\" data-kid=\"1-2-2-3-2-5-1-2-1-3\" data-name=\"trade status cell\"><span class=\"rounded-sm border border-[#3ddc84]/30 bg-[#3ddc84]/10 px-1.5 py-0.5 text-[10px] font-semibold tracking-[0.08em] text-[#3ddc84] uppercase\" data-kid=\"1-2-2-3-2-5-1-2-1-3-1\" data-name=\"win status badge\">Win</span></td><td class=\"fm px-3 text-right\" data-kid=\"1-2-2-3-2-5-1-2-1-4\" data-name=\"trade lots cell\">0.25</td><td class=\"fm px-3 text-right\" data-kid=\"1-2-2-3-2-5-1-2-1-5\" data-name=\"trade entry cell\">3,496.80</td><td class=\"fm px-3 text-right\" data-kid=\"1-2-2-3-2-5-1-2-1-6\" data-name=\"trade exit cell\">3,505.80</td><td class=\"fm px-3 text-right text-[#3ddc84]\" data-kid=\"1-2-2-3-2-5-1-2-1-7\" data-name=\"trade P&amp;L cell\">+$223.25</td><td class=\"fm px-3 text-right text-[#3ddc84]\" data-kid=\"1-2-2-3-2-5-1-2-1-8\" data-name=\"trade R cell\">+2.00</td><td class=\"px-3 text-[#d6d6d4]\" data-kid=\"1-2-2-3-2-5-1-2-1-9\" data-name=\"trade playbook cell\"><span class=\"fm mr-1.5 text-[11px] text-[#a2a2a0]\" data-kid=\"1-2-2-3-2-5-1-2-1-9-1\" data-name=\"playbook letter badge\">C</span>Continuation</td><td class=\"fm px-3 text-[12px] text-[#d6d6d4]\" data-kid=\"1-2-2-3-2-5-1-2-1-10\" data-name=\"trade rules cell\">8 / 8</td><td class=\"pr-6 pl-3 text-center text-[13px] text-[#3ddc84]\" data-kid=\"1-2-2-3-2-5-1-2-1-11\" data-name=\"review check cell\"><i class=\"icon-check\" data-kid=\"1-2-2-3-2-5-1-2-1-11-1\" data-name=\"reviewed checkmark icon\"></i></td>\n</tr>\n<tr class=\"h-10\" data-kid=\"1-2-2-3-2-5-1-2-2\" data-name=\"trade log row (break-even)\">\n<td class=\"fm pl-6 pr-3 text-[12px]\" data-kid=\"1-2-2-3-2-5-1-2-2-1\" data-name=\"trade time cell\">14:22</td><td class=\"px-3\" data-kid=\"1-2-2-3-2-5-1-2-2-2\" data-name=\"trade side cell\">Short</td><td class=\"px-3\" data-kid=\"1-2-2-3-2-5-1-2-2-3\" data-name=\"trade status cell\"><span class=\"whitespace-nowrap rounded-sm border border-white/[0.14] bg-white/[0.05] px-1.5 py-0.5 text-[10px] font-semibold tracking-[0.02em] text-[#d6d6d4] uppercase\" data-kid=\"1-2-2-3