      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Instrument+Serif&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.fs{font-family:'IBM Plex Sans',ui-sans-serif,system-ui,sans-serif}\n.fd{font-family:'Instrument Serif',Georgia,serif}\n.fm{font-family:'IBM Plex Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums}\nbody{background:#000}\n</style>\n<div class=\"fs flex min-h-[880px] items-center justify-center bg-black/80 py-10 text-[#f5f5f4] antialiased\" data-kid=\"1\" data-name=\"modal overlay backdrop\" style=\"background:radial-gradient(ellipse at 50% 0%,rgba(229,9,20,0.10),transparent 60%),rgba(0,0,0,0.92)\">\n<div class=\"flex max-h-[780px] w-[720px] flex-col overflow-hidden rounded-xl border border-white/[0.1] bg-[#0e0e0e] shadow-[0_30px_80px_-20px_rgba(0,0,0,0.9)]\" data-kid=\"1-1\" data-name=\"trade edit modal dialog\">\n<div class=\"flex h-16 shrink-0 items-center justify-between px-6\" data-kid=\"1-1-1\" data-name=\"modal header bar\">\n<div class=\"flex items-baseline gap-3\" data-kid=\"1-1-1-1\" data-name=\"modal title group\">\n<h2 class=\"fd text-[26px] leading-none\" data-kid=\"1-1-1-1-1\" data-name=\"modal title heading\">Edit trade</h2>\n<span class=\"fm text-[12px] text-[#a2a2a0]\" data-kid=\"1-1-1-1-2\" data-name=\"trade timestamp subtitle\">Oct 29, 09:48 ET</span>\n</div>\n<span class=\"text-[17px] text-[#a2a2a0]\" data-kid=\"1-1-1-2\" data-name=\"close dialog button\"><i class=\"icon-x\" data-kid=\"1-1-1-2-1\" data-name=\"close X icon\"></i></span>\n</div>\n<div class=\"flex h-10 shrink-0 items-end gap-6 border-b border-white/[0.07] px-6 text-[11px] font-semibold tracking-[0.14em] uppercase\" data-kid=\"1-1-2\" data-name=\"modal tab navigation\">\n<span class=\"border-b-2 border-[#e50914] pb-2.5 text-white\" data-kid=\"1-1-2-1\" data-name=\"active tab execution\">Execution</span>\n<span class=\"pb-3 text-[#a2a2a0]\" data-kid=\"1-1-2-2\" data-name=\"inactive tab ict review\">ICT &amp; review</span>\n</div>\n<div class=\"min-h-0 flex-1 overflow-y-auto px-6 py-5\" data-kid=\"1-1-3\" data-name=\"modal scrollable content area\">\n<div class=\"grid grid-cols-3 gap-4\" data-kid=\"1-1-3-1\" data-name=\"instrument row grid\">\n<div data-kid=\"1-1-3-1-1\" data-name=\"symbol field group\">\n<p class=\"mb-1.5 text-[11px] font-medium tracking-wider text-[#a2a2a0] uppercase\" data-kid=\"1-1-3-1-1-1\" data-name=\"symbol field label\">Symbol</p>\n<div class=\"flex h-10 items-center justify-between rounded-md border border-white/[0.09] bg-[#151515]/80 px-3 text-[13px] font-semibold\" data-kid=\"1-1-3-1-1-2\" data-name=\"symbol selector value row\">XAUUSD <i class=\"icon-chevron-down text-[14px] font-normal text-[#a2a2a0]\" data-kid=\"1-1-3-1-1-2-1\" data-name=\"chevron down icon\"></i></div>\n</div>\n<div data-kid=\"1-1-3-1-2\" data-name=\"side field group\">\n<p class=\"mb-1.5 text-[11px] font-medium tracking-wider text-[#a2a2a0] uppercase\" data-kid=\"1-1-3-1-2-1\" data-name=\"side field label\">Side</p>\n<div class=\"grid h-10 grid-cols-2 overflow-hidden rounded-md border border-white/[0.1] text-[13px] font-medium\" data-kid=\"1-1-3-1-2-2\" data-name=\"side segmented toggle\">\n<span class=\"flex items-center justify-center text-[#a2a2a0]\" data-dynamic=\"true\" data-kid=\"1-1-3-1-2-2-1\" data-name=\"segment toggle option long false\" data-reason=\"false\">Long</span>\n<span class=\"flex items-center justify-center border-l border-white/[0.1] bg-[#ff6b7d]/15 font-semibold text-[#ff6b7d]\" data-kid=\"1-1-3-1-2-2-2\" data-name=\"short active toggle option\">Short</span>\n</div>\n</div>\n<div data-kid=\"1-1-3-1-3\" data-name=\"position field group\">\n<p class=\"mb-1.5 text-[11px] font-medium tracking-wider text-[#a2a2a0] uppercase\" data-kid=\"1-1-3-1-3-1\" data-name=\"position field label\">Position</p>\n<div class=\"grid h-10 grid-cols-2 overflow-hidden