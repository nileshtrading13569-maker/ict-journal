d=\"1-2-2-3-2-1\" data-name=\"top accent divider\"></div>\n<div class=\"flex items-center justify-between border-b border-white/[0.06] px-6 py-4\" data-kid=\"1-2-2-3-2-2\" data-name=\"detail panel header\">\n<h2 class=\"fd text-[26px] leading-none\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"detail panel date headline\">Wednesday, October 28</h2>\n<span class=\"text-[12px] text-[#a2a2a0]\" data-kid=\"1-2-2-3-2-2-2\" data-name=\"timezone label\">New York time (ET)</span>\n</div>\n<div class=\"grid grid-cols-5 border-b border-white/[0.06] px-6 py-3.5\" data-kid=\"1-2-2-3-2-3\" data-name=\"daily stats grid\">\n<div data-kid=\"1-2-2-3-2-3-1\" data-name=\"stat card\"><p class=\"text-[10px] font-semibold tracking-[0.12em] text-[#a2a2a0] uppercase\" data-kid=\"1-2-2-3-2-3-1-1\" data-name=\"stat label\">Net P&amp;L</p><p class=\"fm mt-1 text-[20px] text-[#3ddc84]\" data-kid=\"1-2-2-3-2-3-1-2\" data-name=\"stat value\">+$206.50</p></div>\n<div data-kid=\"1-2-2-3-2-3-2\" data-name=\"stat card\"><p class=\"text-[10px] font-semibold tracking-[0.12em] text-[#a2a2a0] uppercase\" data-kid=\"1-2-2-3-2-3-2-1\" data-name=\"stat label\">Net R</p><p class=\"fm mt-1 text-[20px] text-[#3ddc84]\" data-kid=\"1-2-2-3-2-3-2-2\" data-name=\"stat value\">+1.89R</p></div>\n<div data-kid=\"1-2-2-3-2-3-3\" data-name=\"stat card\"><p class=\"text-[10px] font-semibold tracking-[0.12em] text-[#a2a2a0] uppercase\" data-kid=\"1-2-2-3-2-3-3-1\" data-name=\"stat label\">Trades</p><p class=\"fm mt-1 text-[20px]\" data-kid=\"1-2-2-3-2-3-3-2\" data-name=\"stat value\">2</p></div>\n<div data-kid=\"1-2-2-3-2-3-4\" data-name=\"stat card\"><p class=\"text-[10px] font-semibold tracking-[0.12em] text-[#a2a2a0] uppercase\" data-kid=\"1-2-2-3-2-3-4-1\" data-name=\"stat label\">Win rate</p><p class=\"fm mt-1 text-[20px]\" data-kid=\"1-2-2-3-2-3-4-2\" data-name=\"stat value\">50%</p></div>\n<div data-kid=\"1-2-2-3-2-3-5\" data-name=\"stat card\"><p class=\"text-[10px] font-semibold tracking-[0.12em] text-[#a2a2a0] upper